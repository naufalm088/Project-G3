# ===== Supabase =====
# Ambil dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role HANYA untuk server-side (migrasi/seed/ingest). Jangan pernah pakai prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ===== Mode demo =====
# true  -> aplikasi memakai data mock, tanpa Supabase (untuk preview UI)
# false -> memakai Supabase Asli
NEXT_PUBLIC_DEMO_MODE=true

# ===== IoT ingest =====
# Kunci bersama perangkat (header x-api-key). Boleh beda dengan API key Supabase.
INGEST_API_KEY=ganti-dengan-kunci-rahasia-panjang

# ===== Simulator =====
# URL target simulator (default: http://localhost:3000)
SIMULATOR_URL=http://localhost:3000
SIMULATOR_INTERVAL_MS=5000
# id perangkat yang terdaftar di tabel devices (setelah seed)
SIMULATOR_DEVICE_ID=

# ===== Aplikasi =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
