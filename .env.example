# ===== Supabase =====
# Ambil dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role HANYA untuk server-side (migrasi/seed/ingest). Jangan pernah pakai prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ===== Mode demo =====
# true  -> aplikasi memakai data mock, tanpa Supabase (untuk preview UI)
# false -> memakai Supabase Asli
NEXT_PUBLIC_DEMO_MODE=true

# ===== Aplikasi =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
